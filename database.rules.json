{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && ((!data.exists() && newData.exists() && newData.child('username').isString() && newData.parent().parent().child('usernames').child(newData.child('username').val().toLowerCase()).val() === $uid) || (data.exists() && !newData.exists() && data.child('username').isString() && !newData.parent().parent().child('usernames').child(data.child('username').val().toLowerCase()).exists()))",
        ".validate": "newData.hasChildren(['username'])",
        "username": {
          ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 42 && newData.val().matches(/^[A-Za-z0-9_]+( [A-Za-z0-9_]+)*$/)"
        },
        "$other": { ".validate": false }
      }
    },
    "usernames": {
      "$name": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && $name.length >= 4 && $name.length <= 42 && $name.matches(/^[a-z0-9_]+( [a-z0-9_]+)*$/) && newData.parent().parent().child('users').child(auth.uid).child('username').isString() && newData.parent().parent().child('users').child(auth.uid).child('username').val().toLowerCase() === $name) || (data.val() === auth.uid && !newData.exists() && !newData.parent().parent().child('users').child(auth.uid).exists()))"
      }
    },
    "gameLibrary": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && auth.token.email_verified === true",
        ".write": "auth != null && auth.uid === $uid && (auth.token.email_verified === true || !newData.exists())",
        "folders": {
          "$folderId": {
            ".validate": "newData.hasChildren(['name'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
            },
            "games": {
              "$gameId": {
                ".validate": "newData.hasChildren(['name', 'pgn'])",
                "name": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
                },
                "pgn": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100000"
                },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
